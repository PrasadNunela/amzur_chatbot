# Backend Environment Variables

# App
SECRET_KEY=your-secret-key-here-change-in-production
JWT_EXPIRE_MINUTES=480
APP_NAME=amzur-ai-chat
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot

# Amzur LiteLLM Proxy
LITELLM_PROXY_URL=https://litellm.amzur.com
LITELLM_API_KEY=sk-your-litellm-api-key-here
LLM_MODEL=gemini/gemini-2.5-flash
LITELLM_EMBEDDING_MODEL=text-embedding-3-large
IMAGE_GEN_MODEL=gemini/imagen-4.0-fast-generate-001

# Optional
CHROMA_PERSIST_DIR=./chroma_db
MAX_UPLOAD_MB=20
UPLOAD_DIR=./uploads
